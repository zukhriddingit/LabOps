# Copy to .env and paste your keys:  cp .env.example .env

# Rasa Pro license (request: https://rasa.com/rasa-pro-developer-edition-license-key-request)
RASA_PRO_LICENSE=your-rasa-pro-license

# Nebius Token Factory — LLM inference (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=your-nebius-key

# Speechmatics — ASR + TTS (https://www.speechmatics.com)
SPEECHMATICS_API_KEY=your-speechmatics-key

# Rime — agent voice / TTS (https://rime.ai)
RIME_API_KEY=your-rime-key

# Where the LabOps backend (Person 2) is running.
LABOPS_API_URL=http://localhost:8000
