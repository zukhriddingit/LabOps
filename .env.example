LABOPS_API_URL=http://localhost:8000

# Rasa Pro/CALM + Nebius Token Factory
NEBIUS_API_KEY=your-nebius-key
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_COMMAND_MODEL=Qwen3-235B-A22B-Instruct-2507

# Speechmatics — powers BOTH ASR (speech-to-text) and TTS (text-to-speech).
# One account key works for both. Put your key here:
SPEECHMATICS_API_KEY=your-speechmatics-key
SPEECHMATICS_BASE_URL=https://asr.api.speechmatics.com/v2
SPEECHMATICS_LANGUAGE=en

# Speechmatics TTS (the active text-to-speech provider)
TTS_PROVIDER=speechmatics
SPEECHMATICS_TTS_URL=https://preview.tts.speechmatics.com/generate
SPEECHMATICS_TTS_VOICE=sarah          # sarah/theo (UK) · megan/jack (US)
# SPEECHMATICS_TTS_API_KEY=           # only if your TTS key differs from SPEECHMATICS_API_KEY

# Rime TTS (legacy fallback — set TTS_PROVIDER=rime to use it instead)
RIME_API_KEY=your-rime-key
RIME_API_URL=https://users.rime.ai/v1/rime-tts
RIME_MODEL_ID=mistv2
RIME_SPEAKER=astra
